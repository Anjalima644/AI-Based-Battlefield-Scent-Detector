import pathlib

tflite_path = pathlib.Path("gas_classifier.tflite")
data = tflite_path.read_bytes()

with open("model_data.h", "w") as f:
    f.write("#include <stdint.h>\n\n")
    f.write("const unsigned char gas_classifier_tflite[] = {")
    for i, b in enumerate(data):
        if i % 12 == 0:
            f.write("\n  ")
        f.write(f"0x{b:02x}, ")
    f.write("\n};\n\n")
    f.write(f"const unsigned int gas_classifier_tflite_len = {len(data)};\n")

print("Wrote model_data.h")
